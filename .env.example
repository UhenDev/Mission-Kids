# MISSION KIDS — Environment Configuration Template
# Salin file ini menjadi .env untuk konfigurasi server lokal atau produksi

# Pengaturan Aplikasi
APP_ENV=production
APP_URL=http://localhost:8080

# Pengaturan Database (Pilihan Driver: mysql atau sqlite)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mission_kids
DB_USERNAME=root
DB_PASSWORD=

# Path SQLite (Digunakan jika DB_DRIVER=sqlite atau fallback saat MySQL offline)
# DB_SQLITE_PATH=database/mission_kids.sqlite

# Integrasi AI Pendamping Belajar (MIKO)
# Opsional: Jika dikosongkan, MIKO otomatis beralih 100% ke mode deterministik offline (Zero-failure guarantee)
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT=4
